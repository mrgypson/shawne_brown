---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioArticleNav from '../../components/PortfolioArticleNav.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { siteConfig } from '../../data/mock/site';
import { getProjectBySlug, getProjects, getSiteSettings } from '../../lib/content';
import { buildCreativeWorkJsonLd } from '../../lib/seo/jsonLd';
import { isNeuhoffProject } from '../../types/project';
import type { Project } from '../../types/project';

export const prerender = false;

const useDraftPerspective = Boolean(Astro.locals.sanityDraftPerspective);
const slug = Astro.params.slug;
const [project, siteSettings, allProjects]: [
	Project | undefined,
	Awaited<ReturnType<typeof getSiteSettings>>,
	Project[],
] = slug
	? await Promise.all([
			getProjectBySlug(slug, { preview: useDraftPerspective }),
			getSiteSettings({ preview: useDraftPerspective }),
			getProjects({ preview: useDraftPerspective }),
		])
	: [undefined, siteConfig, []];

if (!project) {
	return Astro.redirect('/404');
}

const projectIndex = allProjects.findIndex((p) => p.slug === project.slug);
/** Circular “next”: following project, or first when on the last. Omit when only one project (no self-link). */
const nextProject =
	allProjects.length > 1 && projectIndex >= 0
		? allProjects[(projectIndex + 1) % allProjects.length]
		: undefined;

const title = `${project.title} — Fine Art Photography`;
const description = project.shortDescription;
const ogImage = project.coverImage.src;
const ogImageAlt = project.coverImage.alt;
const siteOrigin = Astro.site?.href ?? siteConfig.baseUrl;
const creativeWorkJsonLd = buildCreativeWorkJsonLd(project, siteSettings, siteOrigin);
const showPrintMeta = isNeuhoffProject(project);
---

<BaseLayout
	title={title}
	description={description}
	ogImage={ogImage}
	ogImageAlt={ogImageAlt}
	jsonLd={creativeWorkJsonLd}
>
	<article>
		<header class="prose-narrow">
			<h1 class="page-title">{project.title}</h1>
			<p class="text-muted project-header-year">{project.yearLabel}</p>
			<p class="page-lede project-header-lede">{project.shortDescription}</p>
			{project.longDescription && <p class="prose-narrow project-header-long">{project.longDescription}</p>}
		</header>

		{
			showPrintMeta && (
				<div class="neuhoff-note prose-narrow" role="note" data-testid="neuhoff-print-note">
					<strong>{siteSettings.siteName || siteConfig.siteName} — edition structure</strong>
					<p>
						This series may include limited editions and print sales. Availability, sizing, and framing below are
						placeholder fields for a future inquiry flow — no purchases are processed on this site yet.
					</p>
				</div>
			)
		}

		<ProjectGallery
			images={project.images}
			showPrintMeta={showPrintMeta}
			layout="single"
			spaceBetween={project.gallerySpaceBetween}
			pairGap={project.galleryPairGap}
		/>

		<PortfolioArticleNav
			nextProject={nextProject ? { slug: nextProject.slug, title: nextProject.title } : undefined}
		/>
	</article>
</BaseLayout>
