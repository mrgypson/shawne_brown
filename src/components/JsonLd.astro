---
import type { JsonLd } from '../lib/seo/jsonLd';

interface Props {
	data: JsonLd | JsonLd[];
}

const { data } = Astro.props;
const graphs = Array.isArray(data) ? data : [data];
---

{
	graphs.map((graph) => (
		<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
	))
}
