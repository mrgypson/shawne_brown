---
import type { GalleryImage, GallerySpacingStep } from '../types/project';
import type { NeuhoffImage } from '../types/neuhoff';
import GalleryFigure from './GalleryFigure.astro';
import GalleryRowNav from './GalleryRowNav.astro';

interface Props {
	images: (GalleryImage | NeuhoffImage)[];
	/** When true (e.g. Neuhoff), show optional print-sales metadata blocks. */
	showPrintMeta?: boolean;
	layout?: 'single' | 'two-up';
	/** Gallery-wide vertical gap between rows (0–4). */
	spaceBetween?: GallerySpacingStep;
	/** Gap inside every pair — horizontal gap between the two columns (0–4). */
	pairGap?: GallerySpacingStep;
}

const {
	images,
	showPrintMeta = false,
	layout = 'single',
	spaceBetween = 3,
	pairGap = 2,
} = Astro.props;

type Row =
	| { kind: 'solo'; image: GalleryImage | NeuhoffImage; index: number }
	| {
			kind: 'pair';
			left: GalleryImage | NeuhoffImage;
			right: GalleryImage | NeuhoffImage;
			leftIndex: number;
			rightIndex: number;
	  };

const rows: Row[] = [];
for (let i = 0; i < images.length; i += 1) {
	const current = images[i];
	const next = images[i + 1];
	if (current.pairWithNext && next) {
		rows.push({ kind: 'pair', left: current, right: next, leftIndex: i, rightIndex: i + 1 });
		i += 1;
	} else {
		rows.push({ kind: 'solo', image: current, index: i });
	}
}
---

<div
	class:list={['project-gallery', layout === 'two-up' && 'project-gallery--two-up']}
	id="project-gallery"
	data-testid="project-gallery"
	data-space-between={String(spaceBetween)}
>
	{
		rows.map((row, rowIndex) => {
			const priorityLoad = rowIndex < 2;
			return row.kind === 'solo' ? (
				<GalleryFigure
					image={row.image}
					index={row.index}
					showPrintMeta={showPrintMeta}
					priorityLoad={priorityLoad}
				/>
			) : (
				<div
					class="gallery-pair"
					data-testid={`project-gallery-pair-${rowIndex}`}
					data-pair-gap={String(pairGap)}
					data-ratio={row.left.pairRatio ?? '50/50'}
					data-align-v={row.left.pairAlignVertical ?? 'top'}
				>
					<div class="gallery-pair__row">
						<GalleryFigure
							image={row.left}
							index={row.leftIndex}
							showPrintMeta={showPrintMeta}
							paired
							priorityLoad={priorityLoad}
						/>
						<GalleryFigure
							image={row.right}
							index={row.rightIndex}
							showPrintMeta={showPrintMeta}
							paired
							priorityLoad={priorityLoad}
						/>
					</div>
					<GalleryRowNav />
				</div>
			);
		})
	}
</div>

<script>
	const supportsViewTimeline =
		typeof CSS !== 'undefined' && CSS.supports('animation-timeline: view()');
	const prefersReducedMotion = window.matchMedia(
		'(prefers-reduced-motion: reduce)',
	).matches;

	// Keep initial navigation pinned to top; enable snap only after real scroll intent.
	const root = document.documentElement;
	const enableSnapAfterIntent = () => {
		if (root.classList.contains('project-gallery-snap-active')) return;
		root.classList.add('project-gallery-snap-active');
		window.removeEventListener('wheel', enableSnapAfterIntent);
		window.removeEventListener('touchmove', enableSnapAfterIntent);
		window.removeEventListener('keydown', onSnapIntentKey);
	};
	const onSnapIntentKey = (event: KeyboardEvent) => {
		const scrollKeys = new Set([
			'ArrowDown',
			'ArrowUp',
			'PageDown',
			'PageUp',
			'Home',
			'End',
			' ',
		]);
		if (!scrollKeys.has(event.key)) return;
		enableSnapAfterIntent();
	};
	window.addEventListener('wheel', enableSnapAfterIntent, { passive: true });
	window.addEventListener('touchmove', enableSnapAfterIntent, { passive: true });
	window.addEventListener('keydown', onSnapIntentKey);

	const IDLE_DELAY_MS = 900;
	const NAV_HIDE_DELAY_MS = 2000;

	const isDesktopNavContext = () =>
		window.matchMedia('(min-width: 48rem)').matches &&
		window.matchMedia('(hover: hover) and (pointer: fine)').matches;

	document.querySelectorAll<HTMLElement>('.project-gallery').forEach((gallery) => {
		const figures = Array.from(
			gallery.querySelectorAll<HTMLElement>('.gallery-figure'),
		);
		if (figures.length === 0) return;

		// Browsers without view-timeline support: one-shot fade-in via IO.
		if (!supportsViewTimeline) {
			if (prefersReducedMotion) {
				figures.forEach((f) => f.classList.add('is-revealed'));
			} else {
				const revealObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-revealed');
								revealObserver.unobserve(entry.target);
							}
						});
					},
					{ rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
				);
				figures.forEach((f) => revealObserver.observe(f));
			}
		}

		const rows = Array.from(
			gallery.querySelectorAll<HTMLElement>(':scope > .gallery-figure, :scope > .gallery-pair'),
		);
		if (rows.length === 0) return;

		let idleTimer: ReturnType<typeof setTimeout> | undefined;
		let navHideTimer: ReturnType<typeof setTimeout> | undefined;
		let programmaticNavActive = false;

		const clearNavHideTimer = () => {
			if (navHideTimer) {
				clearTimeout(navHideTimer);
				navHideTimer = undefined;
			}
		};

		const wakeNavControls = () => {
			gallery.classList.remove('is-nav-asleep');
			clearNavHideTimer();
			if (!gallery.classList.contains('is-idle') || !isDesktopNavContext()) return;
			navHideTimer = setTimeout(() => {
				if (gallery.classList.contains('is-idle') && isDesktopNavContext()) {
					gallery.classList.add('is-nav-asleep');
				}
			}, NAV_HIDE_DELAY_MS);
		};

		/** Desktop: hide chevrons until pointer activity; mobile: show with idle focus. */
		const resetNavControlsForIdle = () => {
			clearNavHideTimer();
			if (isDesktopNavContext()) {
				gallery.classList.add('is-nav-asleep');
			} else {
				gallery.classList.remove('is-nav-asleep');
			}
		};

		const sleepNavControls = () => {
			clearNavHideTimer();
			gallery.classList.remove('is-nav-asleep');
		};

		const rowFromFigure = (fig: HTMLElement): HTMLElement => {
			const pair = fig.closest('.gallery-pair');
			if (pair && gallery.contains(pair)) {
				return pair as HTMLElement;
			}
			return fig;
		};

		const updateNavDisabled = () => {
			rows.forEach((row, i) => {
				const prevBtn = row.querySelector<HTMLButtonElement>('[data-gallery-nav="prev"]');
				const nextBtn = row.querySelector<HTMLButtonElement>('[data-gallery-nav="next"]');
				const atFirst = i === 0;
				const atLast = i === rows.length - 1;
				if (prevBtn) {
					prevBtn.disabled = atFirst;
					prevBtn.setAttribute('aria-disabled', String(atFirst));
				}
				if (nextBtn) {
					nextBtn.disabled = atLast;
					nextBtn.setAttribute('aria-disabled', String(atLast));
				}
			});
		};

		const clearFocus = () => {
			figures.forEach((f) => f.classList.remove('is-focused'));
		};

		const findCenteredFigure = (): HTMLElement | null => {
			const viewportCenter = window.innerHeight / 2;
			let closest: HTMLElement | null = null;
			let minDist = Infinity;
			for (const fig of figures) {
				const rect = fig.getBoundingClientRect();
				if (rect.bottom < 0 || rect.top > window.innerHeight) continue;
				const center = rect.top + rect.height / 2;
				const dist = Math.abs(center - viewportCenter);
				if (dist < minDist) {
					minDist = dist;
					closest = fig;
				}
			}
			return closest;
		};

		const enterIdle = () => {
			const focused = findCenteredFigure();
			if (!focused) return;
			clearFocus();
			// When the focused figure is part of a pair, keep both siblings
			// lit so the composed row reads as a single subject.
			const pair = focused.closest('.gallery-pair');
			if (pair && gallery.contains(pair)) {
				pair
					.querySelectorAll<HTMLElement>('.gallery-figure')
					.forEach((f) => f.classList.add('is-focused'));
			} else {
				focused.classList.add('is-focused');
			}
			gallery.classList.add('is-idle');
			updateNavDisabled();
			resetNavControlsForIdle();
		};

		const exitIdle = () => {
			if (idleTimer) {
				clearTimeout(idleTimer);
				idleTimer = undefined;
			}
			sleepNavControls();
			gallery.classList.remove('is-idle');
			clearFocus();
		};

		const scheduleIdle = () => {
			exitIdle();
			idleTimer = setTimeout(enterIdle, IDLE_DELAY_MS);
		};

		const PROGRAMMATIC_SCROLL_CLASS = 'project-gallery-programmatic-scroll';
		const SCROLL_CORRECTION_THRESHOLD_PX = 40;

		const setProgrammaticScroll = (active: boolean) => {
			root.classList.toggle(PROGRAMMATIC_SCROLL_CLASS, active);
		};

		const scrollRowToCenter = (row: HTMLElement, behavior: ScrollBehavior) => {
			const rect = row.getBoundingClientRect();
			const targetTop =
				window.scrollY + rect.top + rect.height / 2 - window.innerHeight / 2;
			window.scrollTo({
				top: Math.max(0, targetTop),
				behavior,
			});
		};

		const rowCenterOffsetFromViewport = (row: HTMLElement): number => {
			const rect = row.getBoundingClientRect();
			const rowCenter = rect.top + rect.height / 2;
			return rowCenter - window.innerHeight / 2;
		};

		const currentNavRow = (): HTMLElement | null => {
			const focusedFig = gallery.querySelector<HTMLElement>('.gallery-figure.is-focused');
			if (focusedFig && gallery.classList.contains('is-idle')) {
				return rowFromFigure(focusedFig);
			}
			const centered = findCenteredFigure();
			return centered ? rowFromFigure(centered) : null;
		};

		const navigateRow = (dir: 'prev' | 'next'): boolean => {
			const currentRow = currentNavRow();
			if (!currentRow) return false;

			const idx = rows.indexOf(currentRow);
			if (idx < 0) return false;

			const targetIdx = dir === 'prev' ? idx - 1 : idx + 1;
			if (targetIdx < 0 || targetIdx >= rows.length) return false;

			const nextRow = rows[targetIdx];
			exitIdle();
			programmaticNavActive = true;
			setProgrammaticScroll(true);
			const scrollBehavior: ScrollBehavior = prefersReducedMotion ? 'instant' : 'smooth';
			scrollRowToCenter(nextRow, scrollBehavior);

			let settled = false;
			let scrollDoneFallback: number | undefined;
			const onScrollDone = () => {
				if (settled) return;
				settled = true;
				window.removeEventListener('scrollend', onScrollDone);
				if (scrollDoneFallback !== undefined) {
					window.clearTimeout(scrollDoneFallback);
				}
				const offset = rowCenterOffsetFromViewport(nextRow);
				if (Math.abs(offset) > SCROLL_CORRECTION_THRESHOLD_PX) {
					scrollRowToCenter(nextRow, 'instant');
				}
				programmaticNavActive = false;
				setProgrammaticScroll(false);
				if (!prefersReducedMotion) {
					scheduleIdle();
				}
			};
			scrollDoneFallback = window.setTimeout(onScrollDone, 900);
			window.addEventListener('scrollend', onScrollDone, { passive: true });
			return true;
		};

		const isTypingTarget = (target: EventTarget | null): boolean => {
			if (!(target instanceof HTMLElement)) return false;
			return Boolean(
				target.closest('input, textarea, select, [contenteditable="true"]'),
			);
		};

		const onGalleryKeydown = (event: KeyboardEvent) => {
			if (!isDesktopNavContext()) return;
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			if (isTypingTarget(event.target)) return;
			if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;

			enableSnapAfterIntent();

			const dir = event.key === 'ArrowDown' ? 'next' : 'prev';
			if (!navigateRow(dir)) return;

			event.preventDefault();
			if (gallery.classList.contains('is-idle') && isDesktopNavContext()) {
				wakeNavControls();
			}
		};

		window.addEventListener('keydown', onGalleryKeydown);

		// Reduced-motion users opt out of the linger-to-focus effect (keyboard nav still works).
		if (prefersReducedMotion) return;

		gallery.addEventListener('click', (event: MouseEvent) => {
			const target = event.target as HTMLElement | null;
			if (!target) return;
			const btn = target.closest<HTMLElement>('[data-gallery-nav]');
			if (!btn || !gallery.contains(btn)) return;
			if (!gallery.classList.contains('is-idle')) return;

			const navButton = btn.closest('button');
			if (navButton?.disabled) return;

			const dir = btn.getAttribute('data-gallery-nav');
			if (dir !== 'prev' && dir !== 'next') return;

			const focusedFig = gallery.querySelector<HTMLElement>('.gallery-figure.is-focused');
			if (!focusedFig) return;

			event.preventDefault();
			navigateRow(dir);
		});

		window.addEventListener(
			'scroll',
			() => {
				if (programmaticNavActive) return;
				scheduleIdle();
			},
			{ passive: true },
		);
		// Cancel pending idle if the user navigates away via tab/blur so we
		// don't lock in a stale focused state when they return.
		window.addEventListener('blur', exitIdle);

		const onPointerActivity = () => {
			if (!gallery.classList.contains('is-idle') || !isDesktopNavContext()) return;
			wakeNavControls();
		};
		window.addEventListener('mousemove', onPointerActivity, { passive: true });
		gallery.addEventListener('mouseenter', onPointerActivity, { passive: true });
	});
</script>
